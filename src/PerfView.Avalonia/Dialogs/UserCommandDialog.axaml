<src:WindowBase x:Class="PerfView.Dialogs.UserCommandDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        xmlns:controls="using:Controls"
        x:CompileBindings="False"
        Background="{DynamicResource ControlDarkerBackground}"
        Title="Executing User Defined Command" Height="90" Width="669" SizeToContent="Height">
    <!-- TODO_AVALONIA: CommandBinding not available in Avalonia -->
    <!--
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="DoHyperlinkHelp" />
    </Window.CommandBindings>
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Classes="link" HorizontalAlignment="Center" Margin="8,2,5,2"
                Click="DoHyperlinkHelp" Tag="UserCommand">
            <TextBlock Name="TitleHyperLinkText" Text="Help on Invoking User Defined Commands"/>
        </Button>
        <controls:HistoryComboBox x:Name="CommandTextBox" Grid.Row="1" Margin="10,2,10,2"
                         ToolTip.Tip="Enter user-defined command. Tab will commit completion."
                         Enter="OKClicked" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Margin="10,5,10,5" Width="80" Content="OK" Click="OKClicked" HorizontalContentAlignment="Center" TabIndex="2"/>
            <Button Margin="10,5,10,5" Width="80" Content="Cancel" Click="CancelClicked" HorizontalContentAlignment="Center" TabIndex="1"/>
            <Button Margin="10,5,10,5" Width="120" Content="Command Help" Click="HelpClicked" HorizontalContentAlignment="Center" TabIndex="0"/>
        </StackPanel>
    </Grid>
</src:WindowBase>
