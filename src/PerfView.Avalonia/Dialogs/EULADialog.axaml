<src:WindowBase x:Class="PerfView.Dialogs.EULADialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        x:CompileBindings="False"
        Title="EULA Acceptance" Height="400" Width="700" MinHeight="200" MinWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12" Margin="20,20,32,20">
                <TextBlock FontSize="16" FontWeight="Bold"
                           Text="MICROSOFT SOFTWARE SUPPLEMENTAL LICENSE TERMS" TextWrapping="Wrap"/>
                <TextBlock FontSize="14" FontWeight="SemiBold"
                           Text="PERFVIEW FOR MICROSOFT .NET FRAMEWORK 2.0 AND/OR SUCCESSOR VERSIONS" TextWrapping="Wrap"/>
                <TextBlock TextWrapping="Wrap" Name="BodyText"/>
                <TextBlock FontWeight="Bold" TextWrapping="Wrap"
                           Text="By using this supplement, you accept these terms. If you do not accept them, do not use this supplement."/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Margin="20,5" Width="80" Grid.Column="1" IsDefault="True" Click="AcceptClick">Accept</Button>
            <Button Margin="20,5" Width="80" Grid.Column="2" Click="DeclineClick">Decline</Button>
        </Grid>
    </Grid>
</src:WindowBase>
