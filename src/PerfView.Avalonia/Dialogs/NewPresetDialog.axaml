<src:WindowBase x:Class="PerfView.Dialogs.NewPresetDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        x:CompileBindings="False"
        Background="{DynamicResource ControlDarkerBackground}"
        Title="New Preset" Height="93.611" Width="400">
    <!-- TODO_AVALONIA: CommandBinding not available in Avalonia -->
    <!--
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="DoHyperlinkHelp" />
    </Window.CommandBindings>
    -->
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Classes="link" Padding="0" HorizontalAlignment="Left" Margin="8,2,5,2" Click="DoHyperlinkHelp" Tag="PresetNameTextBox">Preset Name</Button>
            <TextBox Name="PresetNameTextBox" Width="290" Margin="10,2,10,2" KeyDown="DoKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,0">
            <Button Margin="10,2,10,5" Width="80" Content="OK" Click="OKClicked"/>
        </StackPanel>
    </Grid>
</src:WindowBase>
