<src:WindowBase x:Class="PerfView.Dialogs.SourceNameLookup"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        xmlns:controls="using:Controls"
        x:CompileBindings="False"
        Title="Source Name Lookup" Height="339" Width="619">
    <!-- TODO_AVALONIA: CommandBinding not available in Avalonia -->
    <!--
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="DoHyperlinkHelp"/>
    </Window.CommandBindings>
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main TextBox -->
        <controls:TextEditorControl Grid.Row="0" Margin="5,5" MinHeight="80" x:Name="Names"/>

        <!-- Help message at top -->
        <TextBlock Grid.Row="1" Background="{DynamicResource HelpRibbonBackground}" Margin="5">
            See <InlineUIContainer BaselineAlignment="Center"><Button Classes="link" Padding="0" FontSize="11" Click="DoHyperlinkHelp" Tag="">TODO</Button></InlineUIContainer>.
        </TextBlock>

        <!--  -->
        <Grid Grid.Row="3" Name="ProcessDumpRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Button Classes="link" Padding="0" Grid.Column="0" Margin="5,0" VerticalAlignment="Center" ToolTip.Tip="TODO"
                    Click="DoHyperlinkHelp" Tag="ProcessTextBox">Process:</Button>
            <controls:HistoryComboBox Margin="0,5,5,0" Grid.Column="1" x:Name="ProcessTextBox" VerticalAlignment="Center" />
            <Button Classes="link" Padding="0" Grid.Column="2" Margin="5,0" VerticalAlignment="Center" ToolTip.Tip="TODO"
                    Click="DoHyperlinkHelp" Tag="ModuleTextBox">Module:</Button>
            <controls:HistoryComboBox Margin="0,5,5,0" Grid.Column="3" x:Name="ModuleTextBox" VerticalAlignment="Center" />

            <Button Classes="link" Padding="0" Grid.Column="4" Margin="5,0" VerticalAlignment="Center" ToolTip.Tip="TODO"
                    Click="DoHyperlinkHelp" Tag="NameTextBox">Name:</Button>
            <controls:HistoryComboBox Margin="0,5,5,0" Grid.Column="5" x:Name="NameTextBox" VerticalAlignment="Center" />
        </Grid>
        <!--  -->
        <DataGrid Name="Grid" Grid.Row="4"
            AutoGenerateColumns="False"
            Background="White"
            SelectionMode="Extended"
            CanUserSortColumns="False"
            Height="100">
            <!-- TODO_AVALONIA: AlternatingRowBackground and SelectionUnit="CellOrRowHeader" not available in Avalonia DataGrid -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="File"/>
                <DataGridTextColumn Header="Line"/>
                <DataGridTextColumn Header="Value"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</src:WindowBase>
