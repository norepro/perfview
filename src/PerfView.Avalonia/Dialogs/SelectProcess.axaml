<src:WindowBase x:Class="PerfView.SelectProcess"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        x:CompileBindings="False"
        Title="Select Process Window" Height="369" Width="695">
    <!-- TODO_AVALONIA: CommandBinding not available in Avalonia -->
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#ABADB3" BorderThickness="1">
            <TextBlock Background="{DynamicResource HelpRibbonBackground}" TextWrapping="Wrap" FontSize="11" AutomationProperties.Name="Select process help">
                The data collected was machine wide, but typically you are interested in only one process. This dialog box allows you to choose a particular process to focus on by either double clicking on a process or by selecting a process and hitting OK. The 'All Procs' button can be used if you wish to look at all data. See <InlineUIContainer><Button Classes="link" Padding="0" FontSize="11" Click="DoHyperlinkHelp" Tag="SelectProcessDialog">Selecting A Process Help</Button></InlineUIContainer> for more.
            </TextBlock>
        </Border>
        <Grid DockPanel.Dock="Top" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Fill="{DynamicResource ControlDefaultBackground}"/>
            <!-- TODO_AVALONIA: Hyperlink not available in Avalonia -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip.Tip="Only processes that match this filter pattern are displayed."
                       Text="Filter:"/>
            <TextBox Name="ProcessFilterTextBox" TextChanged="FilterTextChanged" Grid.Column="1" Margin="5,2,2,2" />
        </Grid>
        <Grid DockPanel.Dock="Bottom" Background="{DynamicResource BackgroundColour}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="IncludeChildProcessesCheckBox" Grid.Column="0" Margin="5,0,0,0" VerticalAlignment="Center" 
                     ToolTip.Tip="Include all descendant processes of selected processes">Include descendant processes</CheckBox>
            <Button Name="OKButton" Margin="5,4" Grid.Column="2" MinWidth="80" Content="OK" Click="OKClicked" HorizontalContentAlignment="Center" />
            <Button Name="AllProcsButton" Margin="5,4" Grid.Column="4" MinWidth="80" Content="All Procs" Click="AllProcsClicked"
                    ToolTip.Tip="Investigate all processes" HorizontalContentAlignment="Center"/>
            <Button Margin="5,4" Grid.Column="6" MinWidth="80" Content="Cancel" Click="CancelClicked" HorizontalContentAlignment="Center" />
        </Grid>
        <Grid KeyDown="GridKeyDownHander">
            <DataGrid Name="Grid"
              Background="{DynamicResource BackgroundColour}"
              AutoGenerateColumns="False"
              DoubleTapped="OKClicked"
              IsReadOnly="True"
              FontSize="12"
              AutomationProperties.Name="Process Selection Table">
              <DataGrid.Resources>
                  <!-- Right-align numeric cells, left-align Name/CommandLine via template -->
                  <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
                      <Setter Property="Margin" Value="4,0,4,0" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="TextAlignment" Value="Right" />
                  </ControlTheme>
              </DataGrid.Resources>
              <!-- TODO_AVALONIA: AlternatingRowBackground not in Avalonia DataGrid -->
              <!-- TODO_AVALONIA: ColumnHeaderStyle needs Avalonia style conversion -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding ProcessID}" />
                    <DataGridTextColumn
                        Header="Parent"
                        Binding="{Binding ParentID}" />
                    <DataGridTextColumn
                        Header="CPU MSec"
                        Binding="{Binding CPUTimeMSec, StringFormat={}{0:n0}}" />
                    <DataGridTextColumn
                        Header="Start"
                        Binding="{Binding StartTime, StringFormat={}{0:yy-MM-dd HH:mm:ss}}" />
                    <DataGridTextColumn
                        Header="Duration"
                        Binding="{Binding Duration}" />
                    <DataGridTemplateColumn Header="CommandLine" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CommandLine}" VerticalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</src:WindowBase>
