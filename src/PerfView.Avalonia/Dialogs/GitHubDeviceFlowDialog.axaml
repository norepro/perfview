<src:WindowBase x:Class="PerfView.Dialogs.GitHubDeviceFlowDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="using:PerfView"
        x:CompileBindings="False"
        Title="GitHub Device Authentication" Height="280" Width="500"
        CanResize="False">
    <!-- TODO_AVALONIA: CommandBinding not available in Avalonia -->
    <!--
    <src:WindowBase.CommandBindings>
        <CommandBinding Command="NavigationCommands.GoToPage" Executed="NavigateTo_Executed" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
    </src:WindowBase.CommandBindings>
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="10" TextWrapping="Wrap">
            <Run Text="You're trying to access source code in a private GitHub repo."/>
            <Run Text="If you have a GitHub account, please allow PerfView to sign in and access that repo." />
            <Run Text="Go to" />
            <!-- TODO_AVALONIA: Hyperlink not available in Avalonia -->
            <Run Text="{Binding VerificationUri, Mode=OneWay}"/>
            <Run Text="in a web browser, or click on the GitHub logo, and enter the code below."/>
            <Run Text="Follow the instructions on GitHub.com to sign in." />
            <Run Text="This dialog will automatically close when you have signed in."/>
        </TextBlock>
        <Grid Grid.Row="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!-- TODO_AVALONIA: pack://application URI not available in Avalonia. Use avares:// URI scheme. -->
            <Button Grid.Column="0" Grid.RowSpan="2" Click="NavigateTo_Click">
                <Button.Template>
                    <ControlTemplate>
                        <!-- TODO_AVALONIA: Update image source to use avares:// URI -->
                        <Image Source="/Images/GitHub_Logo.png" Margin="15" Cursor="Hand" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBox Grid.Column="1" BorderBrush="Transparent" IsReadOnly="True" FontSize="32"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding UserCode, Mode=OneWay}" />
            <Button Grid.Column="1" Width="90" Margin="10" Grid.Row="1" Click="Copy_Click">_Copy code</Button>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Margin="10" Width="80" Content="Cancel" Click="Close_Click" />
        </StackPanel>
    </Grid>
</src:WindowBase>
