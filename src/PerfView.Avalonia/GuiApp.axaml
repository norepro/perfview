<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PerfView.GuiApp"
             xmlns:local="using:PerfView"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <!-- TODO_AVALONIA: ViewLocator not yet implemented -->
    </Application.DataTemplates>
  
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DataGridRowAlternateBackground" Color="#F0F0F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DataGridRowAlternateBackground" Color="#2A2A2A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Compact ComboBox: override Fluent defaults -->
            <x:Double x:Key="ComboBoxMinHeight">20</x:Double>
            <Thickness x:Key="ComboBoxPadding">4,1,0,1</Thickness>
            <Thickness x:Key="ComboBoxEditableTextPadding">4,1,24,1</Thickness>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Override Fluent theme resources for compact controls -->
        <Style Selector=":is(Control)">
            <Style.Resources>
                <x:Double x:Key="ComboBoxMinHeight">20</x:Double>
                <Thickness x:Key="ComboBoxPadding">4,1,0,1</Thickness>
                <Thickness x:Key="ComboBoxEditableTextPadding">4,1,24,1</Thickness>
                <x:Double x:Key="TextControlThemeMinHeight">20</x:Double>
                <Thickness x:Key="TextControlThemePadding">4,2,4,2</Thickness>
                <Thickness x:Key="HorizontalMenuFlyoutItemThemePaddingNarrow">4,2,4,2</Thickness>
                <Thickness x:Key="HorizontalMenuFlyoutItemMargin">0</Thickness>
                <Thickness x:Key="ListBoxItemPadding">4,1,4,1</Thickness>
            </Style.Resources>
        </Style>

        <!-- Match WPF PerfView's font size and improve readability -->
        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="20" />
            <Style.Resources>
                <!-- Override CheckBox sizing within DataGrid to fit compact rows -->
                <x:Double x:Key="CheckBoxMinHeight">16</x:Double>
                <!-- Override the Fluent theme's 32px sort icon column in each header -->
                <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
                <!-- Override the Fluent theme's 12,0,12,0 margin on DataGridTextColumn cells -->
                <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Right" />
                </ControlTheme>
            </Style.Resources>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Fluent default: FontSize=15, MinHeight=32. Override for compact rows. -->
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Fluent default: Padding=12,0,0,0  FontSize=12  MinHeight=32. Override for compact headers. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0,2,0,2" />
        </Style>
        <!-- Shrink the checkbox inside DataGrid cells to fit compact rows -->
        <Style Selector="DataGridCell CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="DataGridCell CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="{DynamicResource DataGridRowAlternateBackground}" />
        </Style>
        <!-- Reduce TreeView item padding to match WPF PerfView's compact layout -->
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <!-- Reduce inner content padding in TreeViewItem template -->
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="18" />
        </Style>
        <!-- Compact TabItem styling to match WPF PerfView -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Add bottom margin to tab content so the selected underline doesn't overlap text -->
        <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Compact CheckBox styling -->
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <!-- Compact ComboBox styling to match WPF PerfView -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Compact TextBox styling to match WPF PerfView -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Style hyperlink-like buttons to look like links -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FF4488FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>