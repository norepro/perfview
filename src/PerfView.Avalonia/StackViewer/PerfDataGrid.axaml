<UserControl
        x:Class="PerfView.PerfDataGrid"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converter="using:PerfView.StackViewer"
        mc:Ignorable="d"
        x:CompileBindings="False"
        d:DesignHeight="223" d:DesignWidth="600">
    <UserControl.Resources>
        <converter:ColorValidatorConverter x:Key="converter" />
        <Style x:Key="RightAlign" Selector="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="HistogramCell" Selector="TextBlock">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="HistogramEditCell" Selector="TextBox">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <!-- TODO_AVALONIA: ColumnHeaderStyle with TargetType DataGridColumnHeader -->
        <Style x:Key="ColumnHeaderStyle" Selector="DataGridColumnHeader">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlText}" />
        </Style>
    </UserControl.Resources>
    <!-- TODO_AVALONIA: SelectionUnit="CellOrRowHeader" not available -->
    <!-- TODO_AVALONIA: SelectedCellsChanged not available -->
    <!-- TODO_AVALONIA: AlternatingRowBackground not available -->
    <!-- TODO_AVALONIA: ClipboardCopyMode not available -->
    <!-- TODO_AVALONIA: PreparingCellForEdit not available -->
    <!-- TODO_AVALONIA: ColumnHeaderStyle not available on DataGrid -->
    <DataGrid Name="Grid"
        SelectionMode="Extended"
        AutoGenerateColumns="False"
        CanUserSortColumns="False"
        CanUserResizeColumns="True"
        FontSize="12"
        ColumnWidth="Auto"
        AutomationProperties.Name="Data Grid">
        <DataGrid.Resources>
            <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
            </ControlTheme>
        </DataGrid.Resources>
        <DataGrid.Columns>
            <!-- TODO_AVALONIA: ClipboardContentBinding not available -->
            <DataGridTemplateColumn
                IsReadOnly="True"
                Width="*"
                MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Name="Name" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.Header>
                    <StackPanel Name="NameColumn" Orientation="Horizontal" >
                        <TextBlock Text="Name " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="NameColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                      The name of the method or group (see GroupPat dialog box).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTemplateColumn.Header>
            </DataGridTemplateColumn>
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding InclusiveMetricPercent, StringFormat={}{0:n1}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="IncPercentColumn" Orientation="Horizontal" >
                        <TextBlock Text="Inc % " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="IncPercentColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                     The % of the total sample metric that occurred in this item or any of its callees.
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding InclusiveMetric, StringFormat={}{0:n1}}">
                <DataGridTextColumn.Header >
                    <StackPanel Name="IncColumn" Orientation="Horizontal" >
                        <TextBlock Text="Inc " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="IncColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                     The sum of the sample metric that occurred in this item or any of its callees.
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                CanUserSort="False"
                IsReadOnly="True"
                Binding="{Binding AverageInclusiveMetric, StringFormat={}{0:n1}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="IncAvgColumn" Orientation="Horizontal" >
                        <TextBlock Text="Inc Avg " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="IncAvgColumn">?</Button>
                        <ToolTip.Tip>
                            <TextBlock>
                                     The average of the sample metric that occurred in this item or any of its callees.
                            </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding InclusiveCount, StringFormat={}{0:n0}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="IncCountColumn" Orientation="Horizontal" >
                        <TextBlock Text="Inc Ct " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="IncCountColumn">?</Button>
                        <ToolTip.Tip>
                            <TextBlock>
                                    The count of the instances in item or its children.
                            </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding ExclusiveMetricPercent, StringFormat={}{0:n1}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="ExcPercentColumn" Orientation="Horizontal" >
                        <TextBlock Text="Exc % " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="ExcPercentColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The % of the total sample metric that occurred in this item exclusively (not its children, does include folding).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding ExclusiveMetric, StringFormat={}{0:n0}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="ExcColumn" Orientation="Horizontal" >
                        <TextBlock Text="Exc " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="ExcColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The sum of the sample metric that occurred in this item exclusively (not its children, does include folding).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding ExclusiveCount, StringFormat={}{0:n0}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="ExcCountColumn" Orientation="Horizontal" >
                        <TextBlock Text="Exc Ct " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="ExcCountColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The count of the instances in item (excluding its children, does include folding)
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding ExclusiveFoldedMetric, StringFormat={}{0:n0}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="FoldColumn" Orientation="Horizontal" >
                        <TextBlock Text="Fold " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="FoldColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The exclusive metric that have been folded into this node (by FoldPat or Fold %).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding ExclusiveFoldedCount, StringFormat={}{0:n0}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="FoldCountColumn" Orientation="Horizontal" >
                        <TextBlock Text="Fold Ct " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="FoldCountColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The count that have been folded into this node (by FoldPat or Fold %).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- TODO promote ReadOnly to the table as a whole -->
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <!-- TODO_AVALONIA: EditingElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="False"
                FontFamily="Courier New"
                FontSize="10"
                MinWidth="200"
                Binding="{Binding InclusiveMetricByTimeString}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="WhenColumn" Orientation="Horizontal" Margin="0,0,5,0">
                        <TextBlock Text="When " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="WhenColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock TextAlignment="Left">
                                    The time interval (from Start to End) is divided up into 32 buckets.
The buckets are normalized to a 100% value.
For CPU (and other metrics that naturally represent time like disk time)
100% represents the use of 1 CPU (or disk, or thread ...)
For all other 100% represents half the maximum.
_ = No samples
. =  0% &lt; X &lt; .1%
o =  .1% &lt; X &lt; 1%
0 =  1% &lt; X &lt; 10%
1 = 10% &lt; X &lt; 20%
2 = 20% &lt; X &lt; 30%
...
9 = 90% &lt; X &lt; 100%
A = 100% &lt; X &lt; 110%
...
Z = 350% &lt; X &lt; 360%
* = 360% &lt; X of 1 CPU
a =  -10% &lt; X &lt; 0%
b =  -20% &lt; X &lt; -10%
...
z = -260% &lt; X &lt; -250%
@ = X &lt; -260%

Selecting this text in the status window and use SetRange (Alt-R) to set range.
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <!-- TODO_AVALONIA: EditingElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="False"
                FontFamily="Courier New"
                FontSize="10"
                Binding="{Binding InclusiveMetricByScenarioString}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="WhichColumn" Orientation="Horizontal" Margin="0,0,5,0">
                        <TextBlock Text="Which " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="WhichColumn">?</Button>
                        <ToolTip.Tip>
                            <TextBlock TextAlignment="Left">
                                    The scenarios are divided into up to 32 buckets.
The buckets are normalized to a 100% value.
100% represents half of the maximum across all buckets.
_ = No samples
. =  0% &lt; X &lt; .1%
o =  .1% &lt; X &lt; 1%
0 =  1% &lt; X &lt; 10%
1 = 10% &lt; X &lt; 20%
2 = 20% &lt; X &lt; 30%
...
9 = 90% &lt; X &lt; 100%
A = 100% &lt; X &lt; 110%
...
Z = 350% &lt; X &lt; 360%
* = 360% &lt; X
a =  -10% &lt; X &lt; 0%
b =  -20% &lt; X &lt; -10%
...
z = -260% &lt; X &lt; -250%
@ = X &lt; -260%

Double-click to enter select mode. Select text and use "Set Scenario List" to limit the view to a set of scenarios.
                            </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding FirstTimeRelativeMSec, StringFormat={}{0:n3}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="FirstColumn" Orientation="Horizontal" >
                        <TextBlock Text="First " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="FirstColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The time in of the first sample (msec from start of trace).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- TODO_AVALONIA: ElementStyle not available -->
            <DataGridTextColumn
                IsReadOnly="True"
                Binding="{Binding LastTimeRelativeMSec, StringFormat={}{0:n3}}">
                <DataGridTextColumn.Header>
                    <StackPanel Name="LastColumn" Orientation="Horizontal" >
                        <TextBlock Text="Last " VerticalAlignment="Center"/><Button Classes="link" Padding="0" Click="DoHyperlinkHelp" Tag="LastColumn">?</Button>
                        <ToolTip.Tip>
                                <TextBlock>
                                    The time in of the last sample (msec from start of trace).
                                </TextBlock>
                        </ToolTip.Tip>
                    </StackPanel>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
