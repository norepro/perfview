<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <fallbackPackageFolders>
      <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear/>
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="perfview-build" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/perfview-build/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="perfview-build">
      <package pattern="Microsoft.Diagnostics.Tracing*" />
      <package pattern="PerfView.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Avalonia*" />
      <package pattern="DialogHost.Avalonia" />
      <package pattern="DynamicData" />
      <package pattern="MessageBox.Avalonia" />
      <package pattern="MicroCom.Runtime" />
      <package pattern="ReactiveUI" />
      <package pattern="ReactiveUI.Avalonia" />
      <package pattern="Splat.*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
      <clear />
  </disabledPackageSources>
</configuration>
