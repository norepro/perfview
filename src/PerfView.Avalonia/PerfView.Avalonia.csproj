<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <PerfViewFolder>../PerfView</PerfViewFolder>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="images\**" />
    <AvaloniaResource Include="SplashScreen.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy support files needed at runtime (help pages, etc.) -->
    <Content Include="$(PerfViewFolder)/SupportFiles/UsersGuide.htm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>UsersGuide.htm</Link>
    </Content>
    <Content Include="$(PerfViewFolder)/SupportFiles/HtmlReportUsersGuide.htm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>HtmlReportUsersGuide.htm</Link>
    </Content>
    <Content Include="$(PerfViewFolder)/SupportFiles/PerfViewWebVideos.htm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PerfViewWebVideos.htm</Link>
    </Content>
    <Content Include="$(PerfViewFolder)/SupportFiles/EventCounterVisualization.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>EventCounterVisualization.html</Link>
    </Content>
    <Content Include="$(PerfViewFolder)/SupportFiles/images/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>images/%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(PerfViewFolder)/**/*.xaml.cs">
      <Link>%(RecursiveDir)%(Filename).axaml.cs</Link>
    </Compile>

    <PerfViewExcludes Include="$(PerfViewFolder)/**/*.g.cs" />
    <PerfViewExcludes Include="$(PerfViewFolder)/**/*.xaml.cs" />
    <PerfViewExcludes Include="$(PerfViewFolder)/App.cs" />
    <PerfViewExcludes Include="$(PerfViewFolder)/Dialogs/ImageHelpers.cs" />
    <PerfViewExcludes Include="$(PerfViewFolder)/obj/**" />

    <Compile Include="$(PerfViewFolder)/**/*.cs" Exclude="@(PerfViewExcludes)" />    
    <Compile Include="../EtwHeapDump/DotNetHeapDumper.cs" />
    <Compile Include="../EtwHeapDump/DotNetHeapDumpGraphReader.cs" />
    <Compile Include="../HeapDump/GCHeapDump.cs" />
    <Compile Include="../HeapDumpCommon/DotNetHeapInfo.cs" />
    <Compile Include="../HeapDumpCommon/GCHeapDumpNames.cs" />
    <Compile Include="../MemoryGraph/graph.cs" />
    <Compile Include="../MemoryGraph/MemoryGraph.cs" />
    <Compile Include="../Utilities/DirectoryUtilities.cs" />
    <Compile Include="../Utilities/EnvironmentUtilities.cs" />
    <Compile Include="../Utilities/FileUtilities.cs" />
    <Compile Include="../Utilities/StringUtilities.cs" />
    <Compile Include="../Utilities/SymbolsAuthenticationUtilities.cs" />
    <Compile Include="../Utilities/TeeTextWriter.cs" />
    <Compile Include="../Utilities/XmlUtilities.cs" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Azure.Core" GeneratePathProperty="true" />
    <PackageReference Include="Azure.Identity" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent.SupportFiles" PrivateAssets="all" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" GeneratePathProperty="true" />
    <PackageReference Include="PerfView.SupportFiles" PrivateAssets="all" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!--
    <ProjectReference Include="..\EtwClrProfilerSigning\EtwClrProfilerSigning.csproj" />
    <ProjectReference Include="..\FastSerialization\FastSerialization.csproj" />
    <ProjectReference Include="..\PerfView.Tutorial\PerfView.Tutorial.csproj" />
    -->
    <ProjectReference Include="../CSVReader/CSVReader.csproj" />
    <ProjectReference Include="../SymbolsAuth/SymbolsAuth.csproj" />
    <ProjectReference Include="../TraceEvent/TraceEvent.csproj" />
  </ItemGroup>
</Project>
